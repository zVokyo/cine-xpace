generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique
  createdAt   DateTime     @default(now())
  favorites   Favorite[]
  watchLater  WatchLater[]
  ratings     Rating[]
}

model Channel {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  category    String
  description String?
  year        Int?
  duration    String?
  video       String?
  createdAt   DateTime     @default(now())
  favorites   Favorite[]
  watchLater  WatchLater[]
  ratings     Rating[]
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  channelId Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model WatchLater {
  id        Int      @id @default(autoincrement())
  userId    Int
  channelId Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model Rating {
  id        Int      @id @default(autoincrement())
  value     Int
  userId    Int
  channelId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}
